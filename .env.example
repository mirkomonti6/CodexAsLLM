# Optional configuration for the Codex LLM proxy.
# Copy to .env and adjust as needed. None of these are required to get started.

# Model to use in example.py
CODEX_MODEL=gpt-5.4

# Local port for the Node OAuth bridge (default 7777).
# Note: the OAuth *callback* always uses port 1455 (hard-coded by the OAuth library).
CODEX_OAUTH_BRIDGE_PORT=7777

# Print the Node bridge's stderr to your terminal (1/true to enable).
CODEX_OAUTH_DEBUG=0

# Max number of response turns kept in local history for previous_response_id chains.
CODEX_HISTORY_MAX=1000

# Override the location of the Node bridge directory (advanced).
# CODEX_OAUTH_BRIDGE_DIR=/absolute/path/to/codex_oauth_bridge
